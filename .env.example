# 数据模式:
#   free      免费数据源（baostock + AKShare），无需 Token，开箱即用，推荐
#   websearch 纯角色对话，不走数据接口
DATA_MODE=free

# ===== 免费数据源配置（DATA_MODE=free 时生效）=====
# 依赖随 `uv sync` 一次装齐，无需额外步骤
# 数据源组合: composite(默认, baostock+AKShare) / baostock / akshare
FREE_DATA_PROVIDER=composite
# 免费源并发线程数（默认 1 串行，baostock/AKShare 不宜高并发）
# FREE_DATA_MAX_WORKERS=1

# 数据库配置
DATA_DIR=data
DB_PATH=data/stock_data.db
