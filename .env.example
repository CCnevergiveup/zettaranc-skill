# 数据模式:
#   free      免费数据源（baostock + AKShare），无需 Tushare Token / 中转，推荐
#   jnb       走 Tushare 真实行情（需 Token + 中转 API）
#   websearch 纯角色对话，不走数据接口
DATA_MODE=free

# ===== 免费模式配置（DATA_MODE=free 时生效）=====
# 安装依赖: uv sync --extra free-data
# 数据源组合: composite(默认, baostock+AKShare) / baostock / akshare
FREE_DATA_PROVIDER=composite
# 免费源并发线程数（默认 1 串行，baostock/AKShare 不宜高并发）
# FREE_DATA_MAX_WORKERS=1

# ===== Tushare 配置（仅 DATA_MODE=jnb 时必填）=====
# Token 获取: https://tushare.pro/user/token
TUSHARE_TOKEN=你的_tushare_token
# Tushare 中转 API 地址，格式: https://your-proxy-server.com
TUSHARE_API_URL=
# 可选，实时行情验证地址，一般不需要
# TUSHARE_VERIFY_TOKEN_URL=

# 数据库配置
DATA_DIR=data
DB_PATH=data/stock_data.db
